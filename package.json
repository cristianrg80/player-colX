{
  "name": "player",
  "version": "1.1.0",
  "description": "Reproductor multimedia con programación",
  "main": "main.js",
  "author": "Tu Nombre",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build-win": "electron-builder --win",
    "build": "electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "video.js": "^8.6.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.cch.player",
    "productName": "CCH Player",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "node_modules/**/*",
      "ffmpeg/**/*"
    ],
    "extraResources": [
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": ["**/*"]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}